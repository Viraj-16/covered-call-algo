# Copy this file to ".env" and fill in your key.
# The bot works WITHOUT a key too (it produces a math-only report).

# Google AI Studio (Gemini) API key — get one at https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_google_ai_studio_key_here

# Optional: override the Gemini model (defaults to gemini-1.5-flash)
# GEMINI_MODEL=gemini-1.5-flash

# Optional: override file paths
# PORTFOLIO_FILE=portfolio.json
# REPORT_FILE=reports/sunday_night_report.md